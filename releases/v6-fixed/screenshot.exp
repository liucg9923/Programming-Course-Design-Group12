#!/usr/bin/expect -f
# 自动化驱动 HIS 程序到 4 个截图点
# 用法：bash screenshot.sh

log_user 1
set timeout 10

# 启动程序
spawn ./his

# ============================================================
# 截图点 1：住院办理成功
# ============================================================

# 启动后的 PauseScreen
expect "按回车继续"
send "\r"

# 主菜单 → 1.挂号与充值
expect "请选择操作"
send "1\r"

# 子菜单 → 3.充值入口
expect -re "(挂号与充值模块|挂号与充值)"
expect "请选择"
send "3\r"

# 充值菜单 → 1.按ID查找
expect -re "1\\. 按患者ID查找"
expect "请选择"
send "1\r"

# 输入患者ID 2031
expect "请输入患者ID"
send "2031\r"

# 输入充值金额 2000 元
expect "请输入充值金额"
send "2000\r"

# 充值成功后 PauseScreen
expect "按回车继续"
send "\r"

# 回到挂号与充值子菜单 → 5.返回上级
expect -re "(挂号与充值模块|挂号与充值)"
expect "请选择"
send "5\r"

# 模块返回后会触发主菜单的 PauseScreen
expect "按回车继续"
send "\r"

# 主菜单 → 3.住院管理
expect "请选择操作"
send "3\r"

# 住院菜单 → 2.手动办理住院
expect -re "住院与结算模块"
expect "请选择"
send "2\r"

# 输入患者ID 2031
expect "请输入患者ID"
send "2031\r"

# 输入主治医生ID 1015
expect "请输入主治医生ID"
send "1015\r"

# 输入科室筛选
expect "输入科室"
send "呼吸内科\r"

# 输入床位ID 803
expect "请输入床位ID"
send "803\r"

# 输入预计住院天数 5
expect "请输入预计住院天数"
send "5\r"

# 输入押金 1000 元
expect "请输入押金金额"
send "1000\r"

# 是否从余额扣 → y
expect "是否从患者账户余额"
send "y\r"

# 等待"住院办理成功"出现
expect "住院办理成功"

# 屏幕停在"住院办理成功：患者[2031] 林木 床位=803 押金余额=1000.00元"
puts "\n\n"
puts "=========================================="
puts ">>> 截图点 1 / 4：住院办理成功"
puts ">>> 请用 Cmd+Shift+4 截图！"
puts ">>> 截好后按 Enter 继续到截图点 2"
puts "=========================================="
puts ""
set timeout -1
expect_user -re "(.*)\n"
set timeout 10

# ============================================================
# 截图点 2：当前住院患者列表
# ============================================================

# 接续 PauseScreen
expect "按回车继续"
send "\r"

# 住院菜单 → 1.查看当前住院患者
expect -re "住院与结算模块"
expect "请选择"
send "1\r"

# 等待表头出现
expect "已住天数"
sleep 0.5

puts "\n\n"
puts "=========================================="
puts ">>> 截图点 2 / 4：当前住院患者列表"
puts ">>> 请用 Cmd+Shift+4 截图！"
puts ">>> 截好后按 Enter 继续到截图点 3"
puts "=========================================="
puts ""
set timeout -1
expect_user -re "(.*)\n"
set timeout 10

# ============================================================
# 截图点 3：自动扣费 + 押金预警
# ============================================================

# 接续 PauseScreen
expect "按回车继续"
send "\r"

# 住院菜单 → 0.返回上级（V5 修复版支持 0）
expect -re "住院与结算模块"
expect "请选择"
send "0\r"

# 主菜单 → 9.设置系统时间
expect "请选择操作"
send "9\r"

# 改日期到 4-27
expect "请输入当前日期"
send "20260427\r"

# 小时 9
expect "请输入当前小时"
send "9\r"

# 分钟 0
expect "请输入当前分钟"
send "0\r"

# 星期 4 (周五)
expect "请输入星期"
send "4\r"

# PauseScreen
expect "按回车继续"
send "\r"

# 主菜单 → 3.住院管理
expect "请选择操作"
send "3\r"

# 住院菜单 → 3.补扣未结算住院费
expect -re "住院与结算模块"
expect "请选择"
send "3\r"

# 等待扣费完成
expect "自动扣费完成"
sleep 0.5

puts "\n\n"
puts "=========================================="
puts ">>> 截图点 3 / 4：自动扣费 + 押金预警"
puts ">>> 重点截到 ⚠预警 那几行！"
puts ">>> 请用 Cmd+Shift+4 截图！"
puts ">>> 截好后按 Enter 继续到截图点 4"
puts "=========================================="
puts ""
set timeout -1
expect_user -re "(.*)\n"
set timeout 10

# ============================================================
# 截图点 4：出院结算
# ============================================================

# PauseScreen
expect "按回车继续"
send "\r"

# 住院菜单 → 5.出院结算
expect -re "住院与结算模块"
expect "请选择"
send "5\r"

# 输入要出院的患者ID 2031
expect "请输入要出院的患者ID"
send "2031\r"

# 等待"出院完成"
expect "出院完成"
sleep 0.5

puts "\n\n"
puts "=========================================="
puts ">>> 截图点 4 / 4：出院结算结果"
puts ">>> 请用 Cmd+Shift+4 截图！"
puts ">>> 截好后按 Enter 自动退出程序"
puts "=========================================="
puts ""
set timeout -1
expect_user -re "(.*)\n"
set timeout 10

# ============================================================
# 优雅退出
# ============================================================

expect "按回车继续"
send "\r"

expect -re "住院与结算模块"
expect "请选择"
send "0\r"

expect "请选择操作"
send "10\r"

expect "数据已保存"

puts "\n\n"
puts "=========================================="
puts ">>> 全部 4 张截图完成！"
puts ">>> 截图默认保存在桌面（截屏xxxx.png）"
puts ">>> 把它们粘贴到 Word 对应的 IV-3-X 标题上方"
puts "=========================================="
puts ""

expect eof
