# ============================
# C / C++ 编译产物
# ============================
*.o
*.obj
*.exe
*.out
*.app
*.a
*.so
*.dylib
*.dll
*.lib
*.pdb
*.ilk
*.idb

# 编译出的二进制（无扩展名）
src/**/his
src/**/HIS
src/**/main

# ============================
# Visual Studio / VS Code
# ============================
.vs/
.vscode/
*.vcxproj.user
x64/
x86/
Debug/
Release/
Win32/
*.suo
*.user
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# ============================
# Dev-C++ / Code::Blocks
# ============================
*.layout
*.depend
*.cbp.bak
*.dev.bak

# ============================
# macOS 系统文件
# ============================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ============================
# Windows 系统文件
# ============================
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================
# 编辑器临时文件
# ============================
*~
*.swp
*.swo
*.bak
*.orig
*.tmp

# ============================
# 日志 / 运行时产物
# ============================
*.log
logs/
bad_data.log
operation.log

# ============================
# 大文件 / 归档（不要传原始 rar）
# ============================
*.rar
*.7z
*.zip
!src/**/*.zip
